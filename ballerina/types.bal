# Represents a discount being returned that applies to one or more return line items in an
# order.
# 
# Fixed-amount, order-scoped discounts are distributed across all non-zero return line item totals.
# The amount distributed to each return line item is relative to that item’s contribution to the
# order subtotal
public type OrderReturnDiscount record {
    # The version of the catalog object that this discount references
    @jsondata:Name {value: "catalog_version"}
    int? catalogVersion?;
    # A unique ID that identifies the returned discount only within this order
    string? uid?;
    # The catalog object ID referencing [CatalogDiscount](entity:CatalogDiscount)
    @jsondata:Name {value: "catalog_object_id"}
    string? catalogObjectId?;
    @jsondata:Name {value: "applied_money"}
    Money appliedMoney?;
    # The discount `uid` from the order that contains the original application of this discount
    @jsondata:Name {value: "source_discount_uid"}
    string? sourceDiscountUid?;
    # The percentage of the tax, as a string representation of a decimal number.
    # A value of `"7.25"` corresponds to a percentage of 7.25%.
    # 
    # `percentage` is not set for amount-based discounts
    string? percentage?;
    # Indicates whether this is a line-item or order-level discount
    OrderLineItemDiscountScope scope?;
    # The discount's name
    string? name?;
    @jsondata:Name {value: "amount_money"}
    Money amountMoney?;
    # Indicates how the discount is applied to the associated line item or order
    OrderLineItemDiscountType 'type?;
};

# Represents a [dispute](https://developer.squareup.com/docs/disputes-api/overview) a cardholder initiated with their bank
public type Dispute record {
    # The timestamp when the dispute was reported, in RFC 3339 format
    @jsondata:Name {value: "reported_date"}
    string? reportedDate?;
    # The list of possible reasons why a cardholder might initiate a
    # dispute with their bank
    DisputeReason reason?;
    # The timestamp when the dispute was reported, in RFC 3339 format
    @jsondata:Name {value: "reported_at"}
    string? reportedAt?;
    @jsondata:Name {value: "disputed_payment"}
    DisputedPayment disputedPayment?;
    # The timestamp when the dispute was created, in RFC 3339 format
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "amount_money"}
    Money amountMoney?;
    # The unique ID for this `Dispute`, generated by Square
    @jsondata:Name {value: "dispute_id"}
    string? disputeId?;
    # The current version of the `Dispute`
    int version?;
    # The ID of the location where the dispute originated
    @jsondata:Name {value: "location_id"}
    string? locationId?;
    # The ID of the dispute in the card brand system, generated by the card brand
    @jsondata:Name {value: "brand_dispute_id"}
    string? brandDisputeId?;
    # The timestamp when the dispute was last updated, in RFC 3339 format
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    @jsondata:Name {value: "card_brand"}
    CardBrand cardBrand?;
    # The deadline by which the seller must respond to the dispute, in [RFC 3339 format](https://developer.squareup.com/docs/build-basics/common-data-types/working-with-dates)
    @jsondata:Name {value: "due_at"}
    string? dueAt?;
    # The unique ID for this `Dispute`, generated by Square
    @constraint:String {maxLength: 40, minLength: 1}
    string id?;
    # The list of possible dispute states
    DisputeState state?;
    # The IDs of the evidence associated with the dispute
    @jsondata:Name {value: "evidence_ids"}
    string[]? evidenceIds?;
};

