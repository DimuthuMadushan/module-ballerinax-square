    @jsondata:Name {value: "cash_refunds_money"}
    Money cashRefundsMoney?;
    # The free-form text description of a cash drawer by an employee
    string? description?;
    # The shift start time in RFC 3339 format
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "cash_paid_out_money"}
    Money cashPaidOutMoney?;
    # The ID of the team member that started the cash drawer shift
    @jsondata:Name {value: "opening_team_member_id"}
    string openingTeamMemberId?;
    # The ID of the location the cash drawer shift belongs to
    @jsondata:Name {value: "location_id"}
    string locationId?;
    # The ID of the team member that closed the cash drawer shift by auditing
    # the cash drawer contents
    @jsondata:Name {value: "closing_team_member_id"}
    string closingTeamMemberId?;
    @jsondata:Name {value: "closed_cash_money"}
    Money closedCashMoney?;
    @jsondata:Name {value: "cash_paid_in_money"}
    Money cashPaidInMoney?;
    # The time when the shift began, in ISO 8601 format
    @jsondata:Name {value: "opened_at"}
    string? openedAt?;
    @jsondata:Name {value: "opened_cash_money"}
    Money openedCashMoney?;
    # The shift updated at time in RFC 3339 format
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # The ID of the team member that ended the cash drawer shift
    @jsondata:Name {value: "ending_team_member_id"}
    string endingTeamMemberId?;
    @jsondata:Name {value: "cash_payment_money"}
    Money cashPaymentMoney?;
    # The shift unique ID
    string id?;
    # The current state of a cash drawer shift
    CashDrawerShiftState state?;
    CashDrawerDevice device?;
    # The IDs of all team members that were logged into Square Point of Sale at any
    # point while the cash drawer shift was open
    @jsondata:Name {value: "team_member_ids"}
    string[] teamMemberIds?;
    # The time when the shift ended, in ISO 8601 format
    @jsondata:Name {value: "ended_at"}
    string? endedAt?;
};

