# Represents a tax being returned that applies to one or more return line items in an order.
# 
# Fixed-amount, order-scoped taxes are distributed across all non-zero return line item totals.
# The amount distributed to each return line item is relative to that item’s contribution to the
# order subtotal
public type OrderReturnTax record {
    # The version of the catalog object that this tax references
    @jsondata:Name {value: "catalog_version"}
    int? catalogVersion?;
    # A unique ID that identifies the returned tax only within this order
    string? uid?;
    # The catalog object ID referencing [CatalogTax](entity:CatalogTax)
    @jsondata:Name {value: "catalog_object_id"}
    string? catalogObjectId?;
    @jsondata:Name {value: "applied_money"}
    Money appliedMoney?;
    # The percentage of the tax, as a string representation of a decimal number.
    # For example, a value of `"7.25"` corresponds to a percentage of 7.25%
    string? percentage?;
    # Indicates whether this is a line-item or order-level tax
    OrderLineItemTaxScope scope?;
    # The tax `uid` from the order that contains the original tax charge
    @jsondata:Name {value: "source_tax_uid"}
    string? sourceTaxUid?;
    # The tax's name
    string? name?;
    # Indicates how the tax is applied to the associated line item or order
    OrderLineItemTaxType 'type?;
};

# Represents a refund of a payment made using Square. Contains information about
# the original payment and the amount of money refunded
public type PaymentRefund record {
    # The reason for the refund
    string? reason?;
    @jsondata:Name {value: "app_fee_money"}
    Money appFeeMoney?;
    # Processing fees and fee adjustments assessed by Square for this refund
    @jsondata:Name {value: "processing_fee"}
    ProcessingFee[]? processingFee?;
    # The timestamp of when the refund was created, in RFC 3339 format
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "amount_money"}
    Money amountMoney;
    # The location ID associated with the payment this refund is attached to
    @jsondata:Name {value: "location_id"}
    string? locationId?;
    # Flag indicating whether or not the refund is linked to an existing payment in Square
    boolean unlinked?;
    # The destination type for this refund.
    # 
    # Current values include `CARD`, `BANK_ACCOUNT`, `WALLET`, `BUY_NOW_PAY_LATER`, `CASH`,
    # `EXTERNAL`, and `SQUARE_ACCOUNT`
    @jsondata:Name {value: "destination_type"}
    string? destinationType?;
    # The timestamp of when the refund was last updated, in RFC 3339 format
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # The ID of the payment associated with this refund
    @jsondata:Name {value: "payment_id"}
    string? paymentId?;
    @jsondata:Name {value: "destination_details"}
    DestinationDetails destinationDetails?;
    # The unique ID for this refund, generated by Square
    @constraint:String {maxLength: 255, minLength: 1}
    string id;
    # An optional ID of the team member associated with taking the payment
    @jsondata:Name {value: "team_member_id"}
    string teamMemberId?;
    # The ID of the order associated with the refund
    @jsondata:Name {value: "order_id"}
    string? orderId?;
    # The refund's status:
    # - `PENDING` - Awaiting approval.
    # - `COMPLETED` - Successfully completed.
    # - `REJECTED` - The refund was rejected.
    # - `FAILED` - An error occurred
    string? status?;
    # An optional ID for a Terminal refund
    @jsondata:Name {value: "terminal_refund_id"}
    string terminalRefundId?;
};

