};

# The type of inventory adjustment reason.
# 
# Custom reasons use `CUSTOM` and include a `custom_reason_id`. Standard
# seller-selectable reasons use `RECEIVED`, `DAMAGED`, `THEFT`, `LOST`,
# `RETURNED`, `SPOILAGE_WASTE`, `SAMPLES_PROMOTIONAL`, `INTERNAL_USE`,
# `VENDOR_RETURN`, or `PRODUCTION_WASTE`.
# 
# The writable standard reasons with direction `INCREASE` are `RECEIVED`
# and `RETURNED`. The writable standard reasons with direction `DECREASE`
# are `DAMAGED`, `THEFT`, `LOST`, `SPOILAGE_WASTE`,
# `SAMPLES_PROMOTIONAL`, `INTERNAL_USE`, `VENDOR_RETURN`, and
# `PRODUCTION_WASTE`.
# 
# The `SALE`, `RECOUNT`, `TRANSFER`, `IN_TRANSIT`, and `CANCELED_SALE`
# values identify system-generated inventory events. These values can be
# returned by Square, but cannot be used when writing inventory adjustments
public type InventoryAdjustmentReasonIdType "RECEIVED"|"DAMAGED"|"THEFT"|"LOST"|"RETURNED"|"SPOILAGE_WASTE"|"SAMPLES_PROMOTIONAL"|"INTERNAL_USE"|"VENDOR_RETURN"|"PRODUCTION_WASTE"|"SALE"|"RECOUNT"|"TRANSFER"|"IN_TRANSIT"|"CANCELED_SALE"|"CUSTOM";

# A response that contains a list of `GiftCard` objects. If the request resulted in errors, 
# the response contains a set of `Error` objects
public type ListGiftCardsResponse record {
    # When a response is truncated, it includes a cursor that you can use in a
    # subsequent request to retrieve the next set of gift cards. If a cursor is not present, this is
    # the final response.
    # For more information, see [Pagination](https://developer.squareup.com/docs/working-with-apis/pagination)
    string cursor?;
    # The requested gift cards or an empty object if none are found
    @jsondata:Name {value: "gift_cards"}
    GiftCard[] giftCards?;
    # Any errors that occurred during the request
    Error[] errors?;
};

# A record representing an individual team member for a business
public type TeamMember record {
    # The email address associated with the team member. After accepting the invitation
    # from Square, only the team member can change this value
    @jsondata:Name {value: "email_address"}
    string? emailAddress?;
    # A second ID used to associate the team member with an entity in another system
    @jsondata:Name {value: "reference_id"}
    string? referenceId?;
    # The timestamp when the team member was last updated, in RFC 3339 format
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Whether the team member is the owner of the Square account
    @jsondata:Name {value: "is_owner"}
    boolean isOwner?;
    # The timestamp when the team member was created, in RFC 3339 format
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "assigned_locations"}
    TeamMemberAssignedLocations assignedLocations?;
    # The team member's phone number, in E.164 format. For example:
    # +14155552671 - the country code is 1 for US
    # +551155256325 - the country code is 55 for BR
    @jsondata:Name {value: "phone_number"}
    string? phoneNumber?;
    # The unique ID for the team member
    string id?;
    # The given name (that is, the first name) associated with the team member
    @jsondata:Name {value: "given_name"}
    string? givenName?;
    # The family name (that is, the last name) associated with the team member
    @jsondata:Name {value: "family_name"}
    string? familyName?;
    # Enumerates the possible statuses the team member can have within a business
    TeamMemberStatus status?;
    @jsondata:Name {value: "wage_setting"}
    WageSetting wageSetting?;
};

# A tax applicable to an item
public type CatalogTax record {
    @jsondata:Name {value: "calculation_phase"}
    TaxCalculationPhase calculationPhase?;
    # The percentage of the tax in decimal form, using a `'.'` as the decimal separator and without a `'%'` sign.
    # A value of `7.5` corresponds to 7.5%. For a location-specific tax rate, contact the tax authority of the location or a tax consultant
    string? percentage?;
    # The tax's name. This is a searchable attribute for use in applicable query filters, and its value length is of Unicode code points
    string? name?;
    # The ID of a `CatalogProductSet` object. If set, the tax is applicable to all products in the product set
    @jsondata:Name {value: "applies_to_product_set_id"}
    string? appliesToProductSetId?;
    @jsondata:Name {value: "inclusion_type"}
    TaxInclusionType inclusionType?;
    # If `true`, the fee applies to custom amounts entered into the Square Point of Sale
    # app that are not associated with a particular `CatalogItem`
    @jsondata:Name {value: "applies_to_custom_amounts"}
    boolean? appliesToCustomAmounts?;
    # A Boolean flag to indicate whether the tax is displayed as enabled (`true`) in the Square Point of Sale app or not (`false`)
    boolean? enabled?;
};

