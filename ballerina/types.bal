# The service appointment settings, including where and how the service is provided
public type BusinessAppointmentSettings record {
    # The maximum lead time in seconds before a service can be booked. A booking must be created at most this amount of time before its starting time
    @jsondata:Name {value: "max_booking_lead_time_seconds"}
    int? maxBookingLeadTimeSeconds?;
    @jsondata:Name {value: "cancellation_fee_money"}
    Money cancellationFeeMoney?;
    @jsondata:Name {value: "alignment_time"}
    BusinessAppointmentSettingsAlignmentTime alignmentTime?;
    # Indicates whether customers has an assigned staff member (`true`) or can select s staff member of their choice (`false`)
    @jsondata:Name {value: "skip_booking_flow_staff_selection"}
    boolean? skipBookingFlowStaffSelection?;
    # Indicates whether a customer can choose from all available time slots and have a staff member assigned
    # automatically (`true`) or not (`false`)
    @jsondata:Name {value: "any_team_member_booking_enabled"}
    boolean? anyTeamMemberBookingEnabled?;
    @jsondata:Name {value: "max_appointments_per_day_limit_type"}
    BusinessAppointmentSettingsMaxAppointmentsPerDayLimitType maxAppointmentsPerDayLimitType?;
    # The free-form text of the seller's cancellation policy
    @jsondata:Name {value: "cancellation_policy_text"}
    string? cancellationPolicyText?;
    # Indicates whether a customer can book multiple services in a single online booking
    @jsondata:Name {value: "multiple_service_booking_enabled"}
    boolean? multipleServiceBookingEnabled?;
    # The minimum lead time in seconds before a service can be booked. A booking must be created at least this amount of time before its starting time
    @jsondata:Name {value: "min_booking_lead_time_seconds"}
    int? minBookingLeadTimeSeconds?;
    # Types of the location allowed for bookings.
    # See [BusinessAppointmentSettingsBookingLocationType](#type-businessappointmentsettingsbookinglocationtype) for possible values
    @jsondata:Name {value: "location_types"}
    BusinessAppointmentSettingsBookingLocationType[]? locationTypes?;
    # The cut-off time in seconds for allowing clients to cancel or reschedule an appointment
    @jsondata:Name {value: "cancellation_window_seconds"}
    int? cancellationWindowSeconds?;
    # The maximum number of daily appointments per team member or per location
    @jsondata:Name {value: "max_appointments_per_day_limit"}
    int? maxAppointmentsPerDayLimit?;
    @jsondata:Name {value: "cancellation_policy"}
    BusinessAppointmentSettingsCancellationPolicy cancellationPolicy?;
};

