    @jsondata:Name {value: "adjust_decrement_activity_details"}
    GiftCardActivityAdjustDecrement adjustDecrementActivityDetails?;
    @jsondata:Name {value: "transfer_balance_to_activity_details"}
    GiftCardActivityTransferBalanceTo transferBalanceToActivityDetails?;
    # The ID of the [business location](entity:Location) where the activity occurred
    @jsondata:Name {value: "location_id"}
    string locationId;
    @jsondata:Name {value: "redeem_activity_details"}
    GiftCardActivityRedeem redeemActivityDetails?;
    @jsondata:Name {value: "transfer_balance_from_activity_details"}
    GiftCardActivityTransferBalanceFrom transferBalanceFromActivityDetails?;
    # The gift card account number (GAN). When creating a gift card activity, `gift_card_gan` 
    # is not required if `gift_card_id` is specified
    @jsondata:Name {value: "gift_card_gan"}
    string? giftCardGan?;
    @jsondata:Name {value: "activate_activity_details"}
    GiftCardActivityActivate activateActivityDetails?;
    @jsondata:Name {value: "load_activity_details"}
    GiftCardActivityLoad loadActivityDetails?;
    @jsondata:Name {value: "unblock_activity_details"}
    GiftCardActivityUnblock unblockActivityDetails?;
    # The Square-assigned ID of the gift card activity
    string id?;
    # The gift card ID. When creating a gift card activity, `gift_card_id` is not required if 
    # `gift_card_gan` is specified
    @jsondata:Name {value: "gift_card_id"}
    string? giftCardId?;
    @jsondata:Name {value: "import_activity_details"}
    GiftCardActivityImport importActivityDetails?;
    @jsondata:Name {value: "block_activity_details"}
    GiftCardActivityBlock blockActivityDetails?;
    @jsondata:Name {value: "clear_balance_activity_details"}
    GiftCardActivityClearBalance clearBalanceActivityDetails?;
    @jsondata:Name {value: "import_reversal_activity_details"}
    GiftCardActivityImportReversal importReversalActivityDetails?;
