# The line item being returned in an order
public type OrderReturnLineItem record {
    # The version of the catalog object that this line item references
    @jsondata:Name {value: "catalog_version"}
    int? catalogVersion?;
    @jsondata:Name {value: "quantity_unit"}
    OrderQuantityUnit quantityUnit?;
    # The note of the return line item
    string? note?;
    # The [CatalogItemVariation](entity:CatalogItemVariation) ID applied to this return line item
    @jsondata:Name {value: "catalog_object_id"}
    string? catalogObjectId?;
    # The `uid` of the line item in the original sale order
    @jsondata:Name {value: "source_line_item_uid"}
    string? sourceLineItemUid?;
    # The quantity returned, formatted as a decimal number.
    # For example, `"3"`.
    # 
    # Line items with a `quantity_unit` can have non-integer quantities.
    # For example, `"1.70000"`
    @constraint:String {maxLength: 12, minLength: 1}
    string quantity;
    @jsondata:Name {value: "gross_return_money"}
    Money grossReturnMoney?;
    @jsondata:Name {value: "total_tax_money"}
    Money totalTaxMoney?;
    # The name of the variation applied to this return line item
    @jsondata:Name {value: "variation_name"}
    string? variationName?;
    @jsondata:Name {value: "item_type"}
    OrderLineItemItemType itemType?;
    @jsondata:Name {value: "total_service_charge_money"}
    Money totalServiceChargeMoney?;
    # A unique ID for this return line-item entry
    string? uid?;
    @jsondata:Name {value: "variation_total_price_money"}
    Money variationTotalPriceMoney?;
    @jsondata:Name {value: "base_price_money"}
    Money basePriceMoney?;
    # The [CatalogModifier](entity:CatalogModifier)s applied to this line item
    @jsondata:Name {value: "return_modifiers"}
    OrderReturnLineItemModifier[]? returnModifiers?;
    # The name of the line item
    string? name?;
    @jsondata:Name {value: "total_discount_money"}
    Money totalDiscountMoney?;
    # The list of references to `OrderReturnTax` entities applied to the return line item. Each
    # `OrderLineItemAppliedTax` has a `tax_uid` that references the `uid` of a top-level
    # `OrderReturnTax` applied to the return line item. On reads, the applied amount
    # is populated
    @jsondata:Name {value: "applied_taxes"}
    OrderLineItemAppliedTax[]? appliedTaxes?;
    @jsondata:Name {value: "total_money"}
    Money totalMoney?;
    # The list of references to `OrderReturnServiceCharge` entities applied to the return
    # line item. Each `OrderLineItemAppliedServiceCharge` has a `service_charge_uid` that
    # references the `uid` of a top-level `OrderReturnServiceCharge` applied to the return line
    # item. On reads, the applied amount is populated
    @jsondata:Name {value: "applied_service_charges"}
    OrderLineItemAppliedServiceCharge[]? appliedServiceCharges?;
    # The list of references to `OrderReturnDiscount` entities applied to the return line item. Each
    # `OrderLineItemAppliedDiscount` has a `discount_uid` that references the `uid` of a top-level
    # `OrderReturnDiscount` applied to the return line item. On reads, the applied amount
    # is populated
    @jsondata:Name {value: "applied_discounts"}
    OrderLineItemAppliedDiscount[]? appliedDiscounts?;
};

