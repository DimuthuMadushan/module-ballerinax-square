    string? sellerId?;
    @jsondata:Name {value: "customer_timezone_choice"}
    BusinessBookingProfileCustomerTimezoneChoice customerTimezoneChoice?;
    @jsondata:Name {value: "business_appointment_settings"}
    BusinessAppointmentSettings businessAppointmentSettings?;
};

