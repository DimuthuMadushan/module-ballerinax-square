# Represents a postal address in a country. 
# For more information, see [Working with Addresses](https://developer.squareup.com/docs/build-basics/working-with-addresses)
public type Address record {
    # Indicates the country associated with another entity, such as a business.
    # Values are in [ISO 3166-1-alpha-2 format](http://www.iso.org/iso/home/standards/country_codes.htm)
    Country country?;
    # A civil entity within the address's `administrative_district_level_2`,
    # if any
    @jsondata:Name {value: "administrative_district_level_3"}
    string? administrativeDistrictLevel3?;
    # The city or town of the address. For a full list of field meanings by country, see [Working with Addresses](https://developer.squareup.com/docs/build-basics/working-with-addresses)
    string? locality?;
    # A civil region within the address's `locality`, if any
    string? sublocality?;
    # Optional last name when it's representing recipient
    @jsondata:Name {value: "last_name"}
    string? lastName?;
    # A civil entity within the address's `administrative_district_level_1`.
    # In the US, this is the county
    @jsondata:Name {value: "administrative_district_level_2"}
    string? administrativeDistrictLevel2?;
    # A civil entity within the address's country. In the US, this
    # is the state. For a full list of field meanings by country, see [Working with Addresses](https://developer.squareup.com/docs/build-basics/working-with-addresses)
    @jsondata:Name {value: "administrative_district_level_1"}
    string? administrativeDistrictLevel1?;
    # A civil region within the address's `sublocality_2`, if any
    @jsondata:Name {value: "sublocality_3"}
    string? sublocality3?;
    # A civil region within the address's `sublocality`, if any
    @jsondata:Name {value: "sublocality_2"}
    string? sublocality2?;
    # The first line of the address.
    # 
    # Fields that start with `address_line` provide the address's most specific
    # details, like street number, street name, and building name. They do *not*
    # provide less specific details like city, state/province, or country (these
    # details are provided in other fields)
    @jsondata:Name {value: "address_line_1"}
    string? addressLine1?;
    # The third line of the address, if any
    @jsondata:Name {value: "address_line_3"}
    string? addressLine3?;
    # The second line of the address, if any
    @jsondata:Name {value: "address_line_2"}
    string? addressLine2?;
    # The address's postal code. For a full list of field meanings by country, see [Working with Addresses](https://developer.squareup.com/docs/build-basics/working-with-addresses)
    @jsondata:Name {value: "postal_code"}
    string? postalCode?;
    # Optional first name when it's representing recipient
    @jsondata:Name {value: "first_name"}
    string? firstName?;
};

# A type-specific filter used in a [custom attribute filter](entity:CustomerCustomAttributeFilter) to search based on the value 
# of a customer-related [custom attribute](entity:CustomAttribute)
public type CustomerCustomAttributeFilterValue record {
    # Represents a generic time range. The start and end values are
    # represented in RFC 3339 format. Time ranges are customized to be
    # inclusive or exclusive based on the needs of a particular endpoint.
    # Refer to the relevant endpoint-specific documentation to determine
    # how time ranges are handled
    TimeRange date?;
    # Specifies a decimal number range
    FloatNumberRange number?;
    # A filter for a query based on the value of a `Boolean`-type custom attribute
    boolean? 'boolean?;
    # The customer address filter. This filter is used in a [CustomerCustomAttributeFilterValue](entity:CustomerCustomAttributeFilterValue) filter when
    # searching by an `Address`-type custom attribute
    CustomerAddressFilter address?;
    # A filter to select resources based on an exact field value. For any given
    # value, the value can only be in one property. Depending on the field, either
    # all properties can be set or only a subset will be available.
    # 
    # Refer to the documentation of the field
    FilterValue selection?;
    # A filter to select customers based on exact or fuzzy matching of
    # customer attributes against a specified query. Depending on the customer attributes, 
    # the filter can be case-sensitive. This filter can be exact or fuzzy, but it cannot be both
    CustomerTextFilter phone?;
    # A filter to select customers based on exact or fuzzy matching of
    # customer attributes against a specified query. Depending on the customer attributes, 
    # the filter can be case-sensitive. This filter can be exact or fuzzy, but it cannot be both
    CustomerTextFilter text?;
    # A filter to select customers based on exact or fuzzy matching of
    # customer attributes against a specified query. Depending on the customer attributes, 
    # the filter can be case-sensitive. This filter can be exact or fuzzy, but it cannot be both
    CustomerTextFilter email?;
};

# The list of possible dispute states
public type DisputeState "INQUIRY_EVIDENCE_REQUIRED"|"INQUIRY_PROCESSING"|"INQUIRY_CLOSED"|"EVIDENCE_REQUIRED"|"PROCESSING"|"WON"|"LOST"|"ACCEPTED";

# Represents a Square loyalty program. Loyalty programs define how buyers can earn points and redeem points for rewards. 
# Square sellers can have only one loyalty program, which is created and managed from the Seller Dashboard. 
# For more information, see [Loyalty Program Overview](https://developer.squareup.com/docs/loyalty/overview)
public type LoyaltyProgram record {
    # The timestamp when the reward was last updated, in RFC 3339 format
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    # Represents the naming used for loyalty points
    LoyaltyProgramTerminology terminology?;
    # The [locations](entity:Location) at which the program is active
    @jsondata:Name {value: "location_ids"}
    string[]? locationIds?;
    # Defines how buyers can earn loyalty points from the base loyalty program.
    # To check for associated [loyalty promotions](entity:LoyaltyPromotion) that enable
    # buyers to earn extra points, call [ListLoyaltyPromotions](api-endpoint:Loyalty-ListLoyaltyPromotions)
    @jsondata:Name {value: "accrual_rules"}
    LoyaltyProgramAccrualRule[]? accrualRules?;
    # The timestamp when the program was created, in RFC 3339 format
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    # The Square-assigned ID of the loyalty program. Updates to 
    # the loyalty program do not modify the identifier
    @constraint:String {maxLength: 36}
    string id?;
    # The list of rewards for buyers, sorted by ascending points
    @jsondata:Name {value: "reward_tiers"}
    LoyaltyProgramRewardTier[]? rewardTiers?;
    @jsondata:Name {value: "expiration_policy"}
    LoyaltyProgramExpirationPolicy expirationPolicy?;
    # Indicates whether the program is currently active
    LoyaltyProgramStatus status?;
};

