    # All Connect V2 Transactions have all been converted to Orders including all associated
    # itemization data
    Order 'order?;
};

# Represents a checkout processed by the Square Terminal
public type TerminalCheckout record {
    # An optional note to associate with the checkout, as well as with any payments used to complete the checkout.
    # Note: maximum 500 characters
    string? note?;
    # An RFC 3339 duration, after which the checkout is automatically canceled.
    # A `TerminalCheckout` that is `PENDING` is automatically `CANCELED` and has a cancellation reason
    # of `TIMED_OUT`.
    # 
    # Default: 5 minutes from creation
    # 
    # Maximum: 5 minutes
    @jsondata:Name {value: "deadline_duration"}
    string? deadlineDuration?;
    # An optional user-defined reference ID that can be used to associate
    # this `TerminalCheckout` to another entity in an external system. For example, an order
    # ID generated by a third-party shopping cart. The ID is also associated with any payments
    # used to complete the checkout
    @jsondata:Name {value: "reference_id"}
    string? referenceId?;
    @jsondata:Name {value: "app_fee_money"}
    Money appFeeMoney?;
    # The time when the `TerminalCheckout` was created, as an RFC 3339 timestamp
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "amount_money"}
    Money amountMoney;
    # A list of IDs for payments created by this `TerminalCheckout`
    @jsondata:Name {value: "payment_ids"}
    string[] paymentIds?;
    # The location of the device where the `TerminalCheckout` was directed
    @jsondata:Name {value: "location_id"}
    string locationId?;
    @jsondata:Name {value: "cancel_reason"}
    ActionCancelReason cancelReason?;
    @jsondata:Name {value: "payment_type"}
    CheckoutOptionsPaymentType paymentType?;
    # Optional additional payment information to include on the customer's card statement as
    # part of the statement description. This can be, for example, an invoice number, ticket number,
    # or short description that uniquely identifies the purchase
    @jsondata:Name {value: "statement_description_identifier"}
    string? statementDescriptionIdentifier?;
    # The time when the `TerminalCheckout` was last updated, as an RFC 3339 timestamp
    @jsondata:Name {value: "updated_at"}
    string updatedAt?;
    @jsondata:Name {value: "tip_money"}
    Money tipMoney?;
    @jsondata:Name {value: "device_options"}
    DeviceCheckoutOptions deviceOptions;
    # A unique ID for this `TerminalCheckout`
    @constraint:String {maxLength: 255, minLength: 10}
    string id?;
    # An optional ID of the team member associated with creating the checkout
    @jsondata:Name {value: "team_member_id"}
    string? teamMemberId?;
    # An optional ID of the customer associated with the checkout
    @jsondata:Name {value: "customer_id"}
    string? customerId?;
    # The reference to the Square order ID for the checkout request
    @jsondata:Name {value: "order_id"}
    string? orderId?;
    # The ID of the application that created the checkout
    @jsondata:Name {value: "app_id"}
    string appId?;
    @jsondata:Name {value: "payment_options"}
    PaymentOptions paymentOptions?;
    # The status of the `TerminalCheckout`.
    # Options: `PENDING`, `IN_PROGRESS`, `CANCEL_REQUESTED`, `CANCELED`, `COMPLETED`
    string status?;
};

