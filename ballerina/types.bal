# Represents a tender (i.e., a method of payment) used in a Square transaction
public type Tender record {
    # The ID of the tender's associated transaction
    @jsondata:Name {value: "transaction_id"}
    string? transactionId?;
    @jsondata:Name {value: "card_details"}
    TenderCardDetails cardDetails?;
    @jsondata:Name {value: "bank_account_details"}
    TenderBankAccountDetails bankAccountDetails?;
    # An optional note associated with the tender at the time of payment
    string? note?;
    # The timestamp for when the tender was created, in RFC 3339 format
    @jsondata:Name {value: "created_at"}
    string createdAt?;
    @jsondata:Name {value: "amount_money"}
    Money amountMoney?;
    # Indicates a tender's type
    TenderType 'type;
    @jsondata:Name {value: "processing_fee_money"}
    Money processingFeeMoney?;
    # The ID of the transaction's associated location
    @jsondata:Name {value: "location_id"}
    string? locationId?;
    @jsondata:Name {value: "tip_money"}
    Money tipMoney?;
    # The ID of the [Payment](entity:Payment) that corresponds to this tender.
    # This value is only present for payments created with the v2 Payments API
    @jsondata:Name {value: "payment_id"}
    string? paymentId?;
    @jsondata:Name {value: "cash_details"}
    TenderCashDetails cashDetails?;
    # The tender's unique ID. It is the associated payment ID
    @constraint:String {maxLength: 192}
    string id?;
    @jsondata:Name {value: "buy_now_pay_later_details"}
    TenderBuyNowPayLaterDetails buyNowPayLaterDetails?;
    # If the tender is associated with a customer or represents a customer's card on file,
    # this is the ID of the associated customer
    @jsondata:Name {value: "customer_id"}
    string? customerId?;
    @jsondata:Name {value: "square_account_details"}
    TenderSquareAccountDetails squareAccountDetails?;
    # Additional recipients (other than the merchant) receiving a portion of this tender.
    # For example, fees assessed on the purchase by a third party integration
    @jsondata:Name {value: "additional_recipients"}
    AdditionalRecipient[]? additionalRecipients?;
};

# A Square API V1 identifier of an item, including the object ID and its associated location ID
public type CatalogV1Id record {
    # The ID of the `Location` this Connect V1 ID is associated with
    @jsondata:Name {value: "location_id"}
    string? locationId?;
